{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // CI-01: desligada. Ela e a causa dos erros TS2375 do pipeline: exige que
    // toda propriedade opcional declare `| undefined` explicitamente, e a
    // maioria dos pacotes do ecossistema (pino-http, fastify) nao faz isso.
    // O codigo do projeto foi escrito para passar com ela ligada -- as nossas
    // interfaces declaram `| undefined` e os objetos de opcao sao montados
    // condicionalmente. Reative quando quiser, num PR isolado, depois que a
    // esteira estiver verde: assim um eventual erro sera de terceiro, nao nosso.
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true
  }
}
